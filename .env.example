DATABASE_URL=postgres://ecg_backend:replace-password@127.0.0.1:5432/ecgrhythmia
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-public-key
# Required only for administrator provisioning, never expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy HS256 verification; keep empty for asymmetric signing keys.
SUPABASE_JWT_SECRET=
HOST_IP=127.0.0.1
REST_PORT=8081
WS_PORT=8080
ALLOWED_ORIGINS=https://ecg.example.org
MQTT_ALLOWED_BROKERS=broker.example.org
RECORDS_ROOT=/var/lib/ecgrhythmia/records
UPLOADS_ROOT=/var/lib/ecgrhythmia/uploads
APPLY_MIGRATIONS=false
RUST_LOG=ecg_backend=info,tower_http=warn
